{
  "expo": {
    "name": "UNNA Social App",
    "slug": "bolt-expo-starter",
    "scheme": "unna-social-app",
    "version": "2.2.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O aplicativo precisa acessar suas fotos para permitir que você selecione imagens para seu perfil e eventos.",
          "cameraPermission": "O aplicativo precisa acessar sua câmera para permitir que você tire fotos para seu perfil e eventos.",
          "savePhotosPermission": "O aplicativo precisa permissão para salvar as fotos editadas na sua galeria."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O aplicativo precisa acessar sua localização para mostrar eventos próximos a você.",
          "locationWhenInUsePermission": "O aplicativo precisa acessar sua localização para mostrar eventos próximos a você."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21",
            "extraMavenRepos": [
              "https://maven.google.com"
            ]
          }
        }
      ],
      "expo-router",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#00d9ff"
        }
      ],
      "expo-video",
      "expo-audio",
      [
        "expo-calendar",
        {
          "calendarPermission": "O aplicativo precisa de acesso à sua agenda para salvar eventos com lembretes automáticos."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unna.socialapp",
      "buildNumber": "21",
      "associatedDomains": [
        "applinks:unna.app"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC6r64NqanwHatrR3M99tg44y3nkRsOW94"
        }
      },
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "O aplicativo precisa acessar suas fotos para permitir que você selecione imagens para seu perfil e eventos.",
        "NSCameraUsageDescription": "O aplicativo precisa acessar sua câmera para permitir que você tire fotos para seu perfil e eventos.",
        "NSCalendarsUsageDescription": "O aplicativo precisa de acesso à sua agenda para salvar eventos com lembretes automáticos.",
        "NSRemindersUsageDescription": "O aplicativo precisa de acesso aos seus lembretes para criar alertas de eventos.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "waze",
          "maps",
          "unna"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.bolt.starter",
      "versionCode": 21,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "unna.app",
              "pathPrefix": "/event"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "enableMiniMode": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC6r64NqanwHatrR3M99tg44y3nkRsOW94"
        }
      },
      "navigationBar": {
        "visible": "edgeToEdge",
        "barStyle": "light-content"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8d7349e6-9f11-4973-aaf2-aec83d650f26"
      }
    }
  }
}
