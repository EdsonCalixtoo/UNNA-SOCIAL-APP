{
  "cli": {
    "version": ">= 10.0.0",
    "promptToConfigurePushNotifications": true,
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "channel": "production",
      "ios": {
        "distribution": "store"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      }
    },
    "preview": {
      "channel": "preview",
      "ios": {
        "distribution": "internal"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      }
    },
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal"
    }
  },
  "submit": {
    "production": {}
  }
}
